<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_brokerage_developer_list" model="ir.ui.view">
        <field name="name">brokerage.developer.list</field>
        <field name="model">brokerage.developer</field>
        <field name="arch" type="xml">
            <list string="Developers"
                  default_order="name asc"
                  decoration-muted="not active">

                <field name="name"/>
                <field name="code"/>
                <field name="rm_name"/>
                <field name="rm_mobile"/>
                <field name="rm_email"/>
                <field name="active"/>

            </list>
        </field>
    </record>

    <record id="view_brokerage_developer_form" model="ir.ui.view">
        <field name="name">brokerage.developer.form</field>
        <field name="model">brokerage.developer</field>
        <field name="arch" type="xml">
            <form string="Developer">

                <sheet>

                    <widget name="web_ribbon"
                            title="Archived"
                            bg_color="text-bg-danger"
                            invisible="active"/>

                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name"
                                   placeholder="Developer name..."/>
                        </h1>
                    </div>

                    <group>
                        <group string="Developer Information">
                            <field name="code"/>
                            <field name="active"/>
                        </group>

                        <group string="Primary Relationship Manager">
                            <field name="rm_name"/>
                            <field name="rm_mobile" widget="phone"/>
                            <field name="rm_email" widget="email"/>
                        </group>
                    </group>

                    <notebook>

                        <page string="Projects" name="projects">
                            <field name="project_ids"
                                   context="{'default_developer_id': id}">

                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="code"/>
                                    <field name="location"/>
                                    <field name="project_type"/>
                                    <field name="expected_completion_date"/>
                                    <field name="active"/>
                                </list>

                            </field>
                        </page>

                        <page string="Notes" name="notes">
                            <field name="notes"
                                   placeholder="Developer notes..."/>
                        </page>

                    </notebook>

                </sheet>

            </form>
        </field>
    </record>

    <record id="view_brokerage_developer_search" model="ir.ui.view">
        <field name="name">brokerage.developer.search</field>
        <field name="model">brokerage.developer</field>
        <field name="arch" type="xml">
            <search string="Search Developers">

                <field name="name"/>
                <field name="code"/>
                <field name="rm_name"/>
                <field name="rm_mobile"/>
                <field name="rm_email"/>

                <separator/>

                <filter name="active_developers"
                        string="Active"
                        domain="[('active', '=', True)]"/>

                <filter name="archived_developers"
                        string="Archived"
                        domain="[('active', '=', False)]"/>

                <group>
                    <filter name="group_active"
                            string="Active Status"
                            context="{'group_by': 'active'}"/>
                </group>

            </search>
        </field>
    </record>

    <record id="action_brokerage_developer" model="ir.actions.act_window">
        <field name="name">Developers</field>
        <field name="res_model">brokerage.developer</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id"
               ref="view_brokerage_developer_search"/>
        <field name="context">
            {'search_default_active_developers': 1}
        </field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first property developer.
            </p>
            <p>
                Developers are used in customer requirements,
                meetings, forecasts, and Hot opportunities.
            </p>
        </field>
    </record>

</odoo>