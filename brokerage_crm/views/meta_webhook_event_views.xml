<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_brokerage_meta_webhook_event_list" model="ir.ui.view">
        <field name="name">brokerage.meta.webhook.event.list</field>
        <field name="model">brokerage.meta.webhook.event</field>
        <field name="arch" type="xml">
            <list string="Meta Lead Ads Event Log"
                  create="0" edit="0" delete="0"
                  decoration-success="state == 'processed'"
                  decoration-danger="state == 'failed'"
                  decoration-info="state in ('pending', 'processing')">
                <button name="action_retry_now"
                        type="object"
                        string="Retry"
                        icon="fa-refresh"
                        groups="brokerage_crm.group_brokerage_sales_manager"
                        invisible="state != 'failed'"/>
                <field name="create_date"/>
                <field name="name"/>
                <field name="page_id" optional="show"/>
                <field name="form_id" optional="hide"/>
                <field name="ad_id" optional="hide"/>
                <field name="lead_id"/>
                <field name="duplicate" optional="show"/>
                <field name="duplicate_action" optional="hide"/>
                <field name="state" widget="badge"/>
                <field name="attempt_count"/>
                <field name="next_attempt_at" optional="show"/>
                <field name="processed_at"/>
            </list>
        </field>
    </record>

    <record id="view_brokerage_meta_webhook_event_form" model="ir.ui.view">
        <field name="name">brokerage.meta.webhook.event.form</field>
        <field name="model">brokerage.meta.webhook.event</field>
        <field name="arch" type="xml">
            <form string="Meta Lead Ads Event" create="0" edit="0" delete="0">
                <header>
                    <button name="action_retry_now"
                            type="object"
                            string="Retry Now"
                            class="btn-primary"
                            groups="brokerage_crm.group_brokerage_sales_manager"
                            invisible="state != 'failed'"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="meta_lead_id"/>
                            <field name="page_id"/>
                            <field name="form_id"/>
                            <field name="ad_id"/>
                            <field name="lead_id"/>
                        </group>
                        <group>
                            <field name="state" widget="badge"/>
                            <field name="duplicate"/>
                            <field name="duplicate_action"/>
                            <field name="attempt_count"/>
                            <field name="last_attempt_at"/>
                            <field name="next_attempt_at"/>
                            <field name="processed_at"/>
                        </group>
                    </group>
                    <group string="Processing Error" invisible="not last_error">
                        <field name="last_error" nolabel="1"/>
                    </group>
                    <group string="Original Meta Payload" groups="base.group_system">
                        <field name="payload" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_brokerage_meta_webhook_event_search" model="ir.ui.view">
        <field name="name">brokerage.meta.webhook.event.search</field>
        <field name="model">brokerage.meta.webhook.event</field>
        <field name="arch" type="xml">
            <search string="Meta Lead Ads Event Log">
                <field name="name"/>
                <field name="meta_lead_id"/>
                <field name="page_id"/>
                <field name="lead_id"/>
                <filter name="pending" string="Pending"
                        domain="[('state', 'in', ('pending', 'processing'))]"/>
                <filter name="failed" string="Failed"
                        domain="[('state', '=', 'failed')]"/>
                <filter name="processed" string="Processed"
                        domain="[('state', '=', 'processed')]"/>
                <filter name="duplicates" string="Duplicates"
                        domain="[('duplicate', '=', True)]"/>
                <group>
                    <filter name="group_state" string="State"
                            context="{'group_by': 'state'}"/>
                    <filter name="group_page" string="Page"
                            context="{'group_by': 'page_id'}"/>
                    <filter name="group_day" string="Received Date"
                            context="{'group_by': 'create_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_brokerage_meta_webhook_event" model="ir.actions.act_window">
        <field name="name">Meta Lead Ads Event Log</field>
        <field name="res_model">brokerage.meta.webhook.event</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_brokerage_meta_webhook_event_search"/>
        <field name="context">{}</field>
    </record>

</odoo>
