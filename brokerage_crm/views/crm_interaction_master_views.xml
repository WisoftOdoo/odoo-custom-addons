        <field name="model">brokerage.crm.meeting.type</field>
        <field name="arch" type="xml">
            <form string="Meeting Type">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code" placeholder="Generated automatically when empty"/>
                        <field name="location_mode"/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_brokerage_crm_meeting_type" model="ir.actions.act_window">
        <field name="name">Meeting Types</field>
        <field name="res_model">brokerage.crm.meeting.type</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_brokerage_crm_meeting_outcome_list" model="ir.ui.view">
        <field name="name">brokerage.crm.meeting.outcome.list</field>
        <field name="model">brokerage.crm.meeting.outcome</field>
        <field name="arch" type="xml">
            <list editable="bottom" decoration-muted="not active">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_brokerage_crm_meeting_outcome_form" model="ir.ui.view">
        <field name="name">brokerage.crm.meeting.outcome.form</field>
        <field name="model">brokerage.crm.meeting.outcome</field>
        <field name="arch" type="xml">
            <form string="Meeting Outcome">
                <sheet>
                    <group>
                        <field name="name"/>
