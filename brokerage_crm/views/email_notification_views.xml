<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_brokerage_crm_email_notification_list" model="ir.ui.view">
        <field name="name">brokerage.crm.email.notification.list</field>
        <field name="model">brokerage.crm.email.notification</field>
        <field name="arch" type="xml">
            <list string="Email Delivery Log" create="0" edit="0" delete="0"
                  decoration-success="state == 'sent'"
                  decoration-danger="state == 'failed'"
                  decoration-muted="state in ('skipped', 'cancelled')">
                <button name="action_retry_now" type="object" string="Retry"
                        icon="fa-refresh"
                        groups="brokerage_crm.group_brokerage_sales_manager"
                        invisible="state not in ('failed', 'skipped', 'cancelled')"/>
                <field name="create_date"/>
                <field name="name"/>
                <field name="lead_id"/>
                <field name="recipient_user_id"/>
                <field name="recipient_email"/>
                <field name="notification_type"/>
                <field name="state" widget="badge"/>
                <field name="manual_retry_count" optional="hide"/>
                <field name="queued_at"/>
                <field name="sent_at"/>
            </list>
        </field>
    </record>

    <record id="view_brokerage_crm_email_notification_form" model="ir.ui.view">
        <field name="name">brokerage.crm.email.notification.form</field>
        <field name="model">brokerage.crm.email.notification</field>
        <field name="arch" type="xml">
            <form string="Email Delivery" create="0" edit="0" delete="0">
                <header>
                    <button name="action_retry_now" type="object"
                            string="Retry Now" class="btn-primary"
                            groups="brokerage_crm.group_brokerage_sales_manager"
                            invisible="state not in ('failed', 'skipped', 'cancelled')"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="lead_id"/>
                            <field name="recipient_user_id"/>
                            <field name="recipient_email"/>
                            <field name="notification_type"/>
                            <field name="subject"/>
                        </group>
                        <group>
                            <field name="state" widget="badge"/>
                            <field name="manual_retry_count"/>
                            <field name="queued_at"/>
                            <field name="sent_at"/>
                            <field name="mail_id" groups="base.group_system"/>
                        </group>
                    </group>
                    <group>
                        <field name="reason"/>
                        <field name="failure_reason"/>
                        <field name="deduplication_key" groups="base.group_system"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_brokerage_crm_email_notification_search" model="ir.ui.view">
        <field name="name">brokerage.crm.email.notification.search</field>
        <field name="model">brokerage.crm.email.notification</field>
        <field name="arch" type="xml">
            <search string="Email Delivery Log">
                <field name="name"/>
                <field name="lead_id"/>
                <field name="recipient_user_id"/>
                <field name="recipient_email"/>
                <filter name="queued" string="Queued" domain="[('state', '=', 'queued')]"/>
                <filter name="failed" string="Failed" domain="[('state', '=', 'failed')]"/>
                <filter name="skipped" string="Skipped" domain="[('state', '=', 'skipped')]"/>
                <filter name="sent" string="Sent" domain="[('state', '=', 'sent')]"/>
                <group>
                    <filter name="group_state" string="State" context="{'group_by': 'state'}"/>
                    <filter name="group_type" string="Notification Type" context="{'group_by': 'notification_type'}"/>
                    <filter name="group_recipient" string="Recipient" context="{'group_by': 'recipient_user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_brokerage_crm_email_notification" model="ir.actions.act_window">
        <field name="name">Email Delivery Log</field>
        <field name="res_model">brokerage.crm.email.notification</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_brokerage_crm_email_notification_search"/>
        <field name="context">{'search_default_failed': 1}</field>
    </record>
</odoo>
