<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="mail_activity_view_form_popup_brokerage_reminder" model="ir.ui.view">
        <field name="name">mail.activity.view.form.popup.brokerage.reminder</field>
        <field name="model">mail.activity</field>
        <field name="inherit_id" ref="mail.mail_activity_view_form_popup"/>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <field name="date_deadline" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>
            <field name="user_id" position="before">
                <label for="brokerage_reminder_datetime"
                       string="Due Date &amp; Time"
                       invisible="activity_category == 'meeting'"/>
                <div invisible="activity_category == 'meeting'">
                <field name="brokerage_reminder_datetime"
                       nolabel="1"
                       help="Select the activity deadline and exact Odoo reminder time."/>
                </div>
                <field name="brokerage_reminder_sent_at" invisible="1"/>
                <field name="brokerage_reminder_message_id" invisible="1"/>
            </field>
        </field>
    </record>

    <record id="mail_activity_schedule_view_form_brokerage_reminder" model="ir.ui.view">
        <field name="name">mail.activity.schedule.form.brokerage.reminder</field>
        <field name="model">mail.activity.schedule</field>
        <field name="inherit_id" ref="mail.mail_activity_schedule_view_form"/>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <field name="date_deadline" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>
            <field name="activity_user_id" position="before">
                <label for="brokerage_reminder_datetime"
                       string="Due Date &amp; Time"/>
                <div>
                    <field name="brokerage_reminder_datetime"
                           nolabel="1"
                           required="activity_type_id"
                           help="Select the activity deadline and exact Odoo reminder time."/>
                </div>
            </field>
        </field>
    </record>
</odoo>
