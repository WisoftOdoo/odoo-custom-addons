<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="res_config_settings_view_form_brokerage_ultramsg"
            model="ir.ui.view">
        <field name="name">res.config.settings.brokerage.ultramsg</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="crm.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='crm']" position="inside">
                <block title="Brokerage Telephony"
                       name="brokerage_telephony_settings"
                       groups="base.group_no_one">
                    <setting id="brokerage_telephony_provider"
                             string="Default PBX Provider"
                             help="Provider used for Brokerage CRM click-to-call unless a user-specific override is configured.">
                        <field name="brokerage_telephony_provider_id"
                               options="{'no_create': True}"/>
                        <div class="content-group mt8">
                            <button name="%(brokerage_crm.action_brokerage_telephony_provider)d"
                                    type="action"
                                    string="Manage Telephony Providers"
                                    class="btn-link"
                                    icon="oi-arrow-right"/>
                        </div>
                    </setting>
                </block>
                <block title="Brokerage Assignment SLA"
                       name="brokerage_round_robin_sla_settings"
                       groups="base.group_system,brokerage_crm.group_brokerage_sales_manager">
                    <setting id="brokerage_sla_enabled"
                             string="Assignment First-Contact SLA"
                             help="Apply working-hours reminders, Team Leader escalation, same-team-first reassignment, and eventual cross-team reassignment to normal, reassigned, Not Interested-reassigned, and solo campaign leads.">
                        <field name="brokerage_sla_enabled"/>
                        <div class="content-group mt16"
                             invisible="not brokerage_sla_enabled">
                            <div class="row mt8">
                                <label for="brokerage_sla_reminder_1_minutes"
                                       class="col-lg-5 o_light_label"/>
                                <field name="brokerage_sla_reminder_1_minutes"
                                       class="oe_inline"/>
                                <span class="ms-2">minutes</span>
                            </div>
                            <div class="row mt8">
                                <label for="brokerage_sla_reminder_2_minutes"
                                       class="col-lg-5 o_light_label"/>
                                <field name="brokerage_sla_reminder_2_minutes"
                                       class="oe_inline"/>
                                <span class="ms-2">minutes</span>
                            </div>
                            <div class="row mt8">
                                <label for="brokerage_sla_reminder_3_minutes"
                                       class="col-lg-5 o_light_label"/>
                                <field name="brokerage_sla_reminder_3_minutes"
                                       class="oe_inline"/>
                                <span class="ms-2">minutes</span>
                            </div>
                            <div class="row mt8">
                                <label for="brokerage_sla_escalation_minutes"
                                       class="col-lg-5 o_light_label"/>
                                <field name="brokerage_sla_escalation_minutes"
                                       class="oe_inline"/>
                                <span class="ms-2">minutes</span>
                            </div>
                            <div class="row mt8">
                                <label for="brokerage_sla_reassignment_minutes"
                                       class="col-lg-5 o_light_label"/>
                                <field name="brokerage_sla_reassignment_minutes"
                                       class="oe_inline"/>
                                <span class="ms-2">minutes</span>
                            </div>
                            <div class="text-muted mt8">
                                Times count only inside the assigned team's SLA
                                Working Hours. Assignment WhatsApp alerts are
                                queued immediately, including outside working
                                hours. Agent reminders escalate to the Team
                                Leader. Reassignment then exhausts the current
                                team's Eligible Salespeople before moving to a
                                team selected by Configuration Sequence.
                                Enter 0 to disable an individual step. Enabled steps
                                must be in chronological order.
                            </div>
                        </div>
                    </setting>
                </block>
                <block title="Brokerage Lead Quality Aging"
                       name="brokerage_lead_quality_aging_settings"
                       groups="base.group_system,brokerage_crm.group_brokerage_sales_manager">
                    <setting id="brokerage_lead_quality_aging_enabled"
                             string="Automatic Lead Quality by Creation Age"
                             help="Automatically classify active open leads as Hot, Warm or Cold from the lead creation date.">
                        <field name="brokerage_lead_quality_aging_enabled"/>
                        <div class="content-group mt16"
                             invisible="not brokerage_lead_quality_aging_enabled">
                            <div class="row mt8">
                                <label for="brokerage_lead_quality_hot_days"
                                       class="col-lg-4 o_light_label"/>
                                <field name="brokerage_lead_quality_hot_days"
                                       class="oe_inline"/>
                                <span class="ms-2">days from creation</span>
                            </div>
                            <div class="row mt8">
                                <label for="brokerage_lead_quality_warm_days"
                                       class="col-lg-4 o_light_label"/>
                                <field name="brokerage_lead_quality_warm_days"
                                       class="oe_inline"/>
                                <span class="ms-2">days from creation</span>
                            </div>
                            <div class="text-muted mt8">
                                With the default values, leads are Hot from day
                                0 through day 30, Warm from day 31 through day
                                90, and Cold after day 90. New leads are
                                classified immediately; active open leads are
                                reviewed daily. Closed, Lost, Invalid, final
                                Not Interested and archived leads are not
                                changed.
                            </div>
                        </div>
                    </setting>
                </block>
                <block title="Brokerage WhatsApp Notifications"
                       name="brokerage_ultramsg_settings"
                       groups="base.group_system">
                    <setting id="brokerage_ultramsg_enabled"
                             string="UltraMsg WhatsApp"
                             help="Send queued lead assignment and SLA notifications through UltraMsg.">
                        <field name="brokerage_ultramsg_enabled"/>
                        <div class="content-group mt16"
                             invisible="not brokerage_ultramsg_enabled">
                            <div class="row mt8">
                                <label for="brokerage_ultramsg_instance_id"
                                       class="col-lg-4 o_light_label"/>
                                <field name="brokerage_ultramsg_instance_id"
                                       class="oe_inline"
                                       placeholder="instance123456"
                                       required="brokerage_ultramsg_enabled"/>
                            </div>
                            <div class="row mt8">
                                <label for="brokerage_ultramsg_token"
                                       class="col-lg-4 o_light_label"/>
                                <field name="brokerage_ultramsg_token"
                                       class="oe_inline"
                                       password="True"
                                       required="brokerage_ultramsg_enabled"/>
                            </div>
                            <div class="row mt8">
                                <label for="brokerage_ultramsg_default_country_code"
                                       class="col-lg-4 o_light_label"/>
                                <field name="brokerage_ultramsg_default_country_code"
                                       class="oe_inline"
                                       placeholder="971"
                                       required="brokerage_ultramsg_enabled"/>
                            </div>
                            <div class="row mt8">
                                <label for="brokerage_ultramsg_connect_timeout"
                                       class="col-lg-4 o_light_label"/>
                                <field name="brokerage_ultramsg_connect_timeout"
                                       class="oe_inline"
                                       required="brokerage_ultramsg_enabled"/>
                                <span class="ms-2">seconds</span>
                            </div>
                            <div class="row mt8">
                                <label for="brokerage_ultramsg_read_timeout"
                                       class="col-lg-4 o_light_label"/>
                                <field name="brokerage_ultramsg_read_timeout"
                                       class="oe_inline"
                                       required="brokerage_ultramsg_enabled"/>
                                <span class="ms-2">seconds</span>
                            </div>
                            <div class="row mt8">
                                <label for="brokerage_ultramsg_max_attempts"
                                       class="col-lg-4 o_light_label"/>
                                <field name="brokerage_ultramsg_max_attempts"
                                       class="oe_inline"
                                       required="brokerage_ultramsg_enabled"/>
                            </div>
                            <div class="row mt8">
                                <label for="brokerage_ultramsg_retry_base_minutes"
                                       class="col-lg-4 o_light_label"/>
                                <field name="brokerage_ultramsg_retry_base_minutes"
                                       class="oe_inline"
                                       required="brokerage_ultramsg_enabled"/>
                                <span class="ms-2">minutes</span>
                            </div>
                            <div class="row mt8">
                                <label for="brokerage_ultramsg_retry_max_minutes"
                                       class="col-lg-4 o_light_label"/>
                                <field name="brokerage_ultramsg_retry_max_minutes"
                                       class="oe_inline"
                                       required="brokerage_ultramsg_enabled"/>
                                <span class="ms-2">minutes</span>
                            </div>
                            <div class="row mt8">
                                <label for="brokerage_ultramsg_failure_alert_user_id"
                                       class="col-lg-4 o_light_label"/>
                                <field name="brokerage_ultramsg_failure_alert_user_id"
                                       class="oe_inline"
                                       options="{'no_create': True}"/>
                            </div>
                            <div class="text-muted mt8">
                                Recipient numbers are read from each Odoo user's
                                Contact: Mobile first, then Phone. Missing or invalid
                                numbers are skipped and shown in the delivery log.
                                Retries use exponential backoff. The token is stored
                                as a protected system parameter and is never written
                                to delivery logs or chatter.
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>

</odoo>
