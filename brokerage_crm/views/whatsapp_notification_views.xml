<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_brokerage_whatsapp_notification_list"
            model="ir.ui.view">
        <field name="name">brokerage.whatsapp.notification.list</field>
        <field name="model">brokerage.whatsapp.notification</field>
        <field name="arch" type="xml">
            <list string="WhatsApp Delivery Log"
                  create="0" edit="0" delete="0"
                  decoration-success="state == 'sent'"
                  decoration-danger="state == 'failed'"
                  decoration-muted="state == 'skipped'">
                <field name="create_date"/>
                <field name="name"/>
                <field name="lead_id"/>
                <field name="recipient_user_id"/>
                <field name="recipient_phone"/>
                <field name="notification_type"/>
                <field name="state" widget="badge"/>
                <field name="attempt_count"/>
                <field name="sent_at"/>
            </list>
        </field>
    </record>

    <record id="view_brokerage_whatsapp_notification_form"
            model="ir.ui.view">
        <field name="name">brokerage.whatsapp.notification.form</field>
        <field name="model">brokerage.whatsapp.notification</field>
        <field name="arch" type="xml">
            <form string="WhatsApp Delivery" create="0" edit="0" delete="0">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="lead_id"/>
                            <field name="recipient_user_id"/>
                            <field name="recipient_phone"/>
                            <field name="notification_type"/>
                        </group>
                        <group>
                            <field name="state" widget="badge"/>
                            <field name="attempt_count"/>
                            <field name="next_attempt_at"/>
                            <field name="sent_at"/>
                            <field name="http_status"/>
                            <field name="external_message_id"/>
                        </group>
                    </group>
                    <group>
                        <field name="body"/>
                        <field name="response_message"/>
                        <field name="deduplication_key" groups="base.group_system"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_brokerage_whatsapp_notification_search"
            model="ir.ui.view">
        <field name="name">brokerage.whatsapp.notification.search</field>
        <field name="model">brokerage.whatsapp.notification</field>
        <field name="arch" type="xml">
            <search string="WhatsApp Delivery Log">
                <field name="name"/>
                <field name="lead_id"/>
                <field name="recipient_user_id"/>
                <filter name="pending" string="Pending"
                        domain="[('state', '=', 'pending')]"/>
                <filter name="failed" string="Failed"
                        domain="[('state', '=', 'failed')]"/>
                <filter name="skipped" string="Skipped"
                        domain="[('state', '=', 'skipped')]"/>
                <filter name="sent" string="Sent"
                        domain="[('state', '=', 'sent')]"/>
                <group>
                    <filter name="group_state" string="State"
                            context="{'group_by': 'state'}"/>
                    <filter name="group_type" string="Notification Type"
                            context="{'group_by': 'notification_type'}"/>
                    <filter name="group_recipient" string="Recipient"
                            context="{'group_by': 'recipient_user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_brokerage_whatsapp_notification"
            model="ir.actions.act_window">
        <field name="name">WhatsApp Delivery Log</field>
        <field name="res_model">brokerage.whatsapp.notification</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id"
               ref="view_brokerage_whatsapp_notification_search"/>
        <field name="context">{'search_default_failed': 1}</field>
    </record>

</odoo>
