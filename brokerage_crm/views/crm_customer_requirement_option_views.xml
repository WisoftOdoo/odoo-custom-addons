<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_brokerage_customer_requirement_option_list" model="ir.ui.view">
        <field name="name">brokerage.crm.customer.requirement.option.list</field>
        <field name="model">brokerage.crm.customer.requirement.option</field>
        <field name="arch" type="xml">
            <list editable="bottom" decoration-muted="not active">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="option_type"/>
                <field name="code"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_brokerage_customer_requirement_option_form" model="ir.ui.view">
        <field name="name">brokerage.crm.customer.requirement.option.form</field>
        <field name="model">brokerage.crm.customer.requirement.option</field>
        <field name="arch" type="xml">
            <form string="Customer Requirement Option">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="option_type"/>
                        <field name="code" placeholder="Generated automatically when empty"/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_brokerage_customer_requirement_option_search" model="ir.ui.view">
        <field name="name">brokerage.crm.customer.requirement.option.search</field>
        <field name="model">brokerage.crm.customer.requirement.option</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="option_type"/>
                <filter name="active_options" string="Active" domain="[('active', '=', True)]"/>
                <filter name="archived_options" string="Archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_option_type" string="Option Type" context="{'group_by': 'option_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_brokerage_customer_requirement_option" model="ir.actions.act_window">
        <field name="name">Customer Requirement Options</field>
        <field name="res_model">brokerage.crm.customer.requirement.option</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_brokerage_customer_requirement_option_search"/>
        <field name="context">{'search_default_active_options': 1}</field>
    </record>
</odoo>
